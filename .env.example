# Copy this file to `.env` and fill in the values.
# `.env` is gitignored; never commit your real API key.
#
#   cp .env.example .env
#   ${EDITOR:-vi} .env
#
# The deploy script auto-sources `.env` if it exists, so you don't need to
# `source` it yourself.

# --- Datadog ----------------------------------------------------------------
# OPTIONAL. If unset, the script deploys the Cloud Run function but skips
# `datadog-ci cloud-run instrument` (that command validates the key against
# Datadog's API and refuses to run with a bad/empty value). Set this and
# re-run to add the sidecar. Get the key from:
#   https://app.datadoghq.com/organization-settings/api-keys
# (use the org for the same site you set in DD_SITE).
# DD_API_KEY="REPLACE_ME"

# OPTIONAL. Only consumed when DD_API_KEY is also set (i.e. when the script
# runs `datadog-ci cloud-run instrument`). Defaults to datadoghq.com.
# Options: datadoghq.com (US1) | datadoghq.eu (EU1) | us3.datadoghq.com |
#          us5.datadoghq.com | ap1.datadoghq.com | ddog-gov.com
# DD_SITE="datadoghq.com"

# Logical service name in Datadog APM. Used as `DD_SERVICE` on both the
# application container and the Datadog sidecar.
DD_SERVICE="code-origin-demo"

# --- GCP --------------------------------------------------------------------
PROJECT_ID="your-gcp-project-id"
GCP_FUNCTION_NAME="code-origin-demo"
REGION="us-central1"
